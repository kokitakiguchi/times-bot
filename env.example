DISCORD_TOKEN=your_bot_token_here
GUILD_ID=your_guild_id_here
TIMES_CATEGORY_ID=your_times_category_id_here
# Set to false only when Message Content Intent is unavailable, but note that message persistence requires Message Content Intent.
DISCORD_ENABLE_MESSAGE_CONTENT_INTENT=true
# Path to SQLite database file (default: data/times.sqlite)
TIMES_DB_PATH=data/times.sqlite
